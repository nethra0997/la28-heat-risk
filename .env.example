# Copy to .env and fill in. Everything works without these except where noted.

# EPA AirNow (current AQ observations) - https://docs.airnowapi.org/account/request/
AIRNOW_API_KEY=
# Census API (direct ACS pulls; without it SVI's ACS estimates are used) - https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
# NOAA NCEI token (reserved for station-vs-reanalysis validation) - https://www.ncdc.noaa.gov/cdo-web/token
NOAA_NCEI_TOKEN=

# LLM for venue briefs: "ollama" (local, free) or "claude"
LA28_LLM=ollama
LA28_OLLAMA_MODEL=llama3:instruct
ANTHROPIC_API_KEY=
LA28_CLAUDE_MODEL=claude-haiku-4-5-20251001
