# Copy this file to .env and fill in what you use. .env is gitignored: keys never reach GitHub.

# Which LLM writes the venue briefs (ai/briefs.py): "ollama" (local, free) or "claude"
LA28_LLM=ollama
LA28_OLLAMA_MODEL=llama3:instruct

# Only needed when LA28_LLM=claude. Create a key at https://platform.claude.com/
ANTHROPIC_API_KEY=
LA28_CLAUDE_MODEL=claude-opus-5-5
